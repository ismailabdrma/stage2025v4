# Stage2025 Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/stage-db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=10

# JWT Security
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters_long

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Admin Configuration
ADMIN_EMAIL=admin@stage2025.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_USERNAME=admin

# Application Configuration
EMAIL_FROM=noreply@stage2025.com
BASE_URL=http://localhost:4200

# Development/Production Profile
SPRING_PROFILES_ACTIVE=development

